# ─────────────────────────── Servidor ───────────────────────────
PORT=3001
HOST=0.0.0.0

# Carpeta de datos y sesiones de WhatsApp.
# En Render con disco persistente usá /var/data.
DATA_DIR=./data

# Protege el panel y la API con un token.
# Ingresá a http://localhost:3001/?token=TU_TOKEN una vez para guardar la cookie.
AUTH_TOKEN=

# URL pública del servidor (se muestra en enlaces y en la página Conexión)
PUBLIC_URL=

# Orígenes permitidos para CORS: "*" o lista separada por comas.
# Ejemplo: https://mi-panel.vercel.app,https://otro-dominio.com
CORS_ORIGINS=*

# Nivel de logs de Baileys: silent | info | debug
LOG_LEVEL=silent

# development | production
NODE_ENV=development

# Forzar modo serverless (sin canales persistentes). En Vercel se detecta solo.
# SERVERLESS=1

# Avisar en la interfaz que el disco es efímero (Render Free). El blueprint lo activa.
# EPHEMERAL_DATA=true

# ──────────────── Frontend (build de Vite / Vercel) ─────────────
# Solo si la interfaz se sirve en un dominio distinto al backend,
# por ejemplo: frontend en Vercel + API en Render.
# VITE_API_URL=https://botforge.onrender.com
# VITE_SOCKET_URL=https://botforge.onrender.com
# Token para APIs protegidas (equivale a AUTH_TOKEN del servidor).
# VITE_AUTH_TOKEN=
