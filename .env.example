# Puerto del servidor (API y producción)
PORT=3001

# Interfaz de escucha
HOST=0.0.0.0

# Carpeta de datos y sesiones de WhatsApp
DATA_DIR=./data

# Protege el panel y la API con un token. Dejalo vacío para uso local.
# Con token: abrí http://localhost:3001/?token=TU_TOKEN (o /?token=... en el frontend)
AUTH_TOKEN=

# URL pública del servidor (se muestra en la documentación de Teams)
PUBLIC_URL=

# Nivel de logs de Baileys: silent | info | debug
LOG_LEVEL=silent

# Entorno: development | production
NODE_ENV=development
